{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "packages": {
    "node": "22"
  },
  "steps": {
    "build": {
      "commands": [
        {
          "cmd": "sh scripts/build-ui.sh",
          "customName": "Build the static app"
        }
      ]
    }
  },
  "deploy": {
    "startCommand": "node frontend/scripts/static-server.mjs"
  }
}
