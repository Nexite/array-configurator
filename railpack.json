{
  "$schema": "https://schema.railpack.com",
  "provider": "python",
  "packages": {
    "python": "3.12",
    "node": "22"
  },
  "steps": {
    "build": {
      "commands": [
        "...",
        {
          "cmd": "sh scripts/build-ui.sh",
          "customName": "Build UI into FastAPI static"
        }
      ]
    }
  },
  "deploy": {
    "startCommand": "uvicorn app.main:app --app-dir backend --host 0.0.0.0 --port ${PORT:-8080}"
  }
}
